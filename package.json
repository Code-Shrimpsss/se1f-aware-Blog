{
    "name": "nextjs-blog",
    "version": "2.1.0",
    "private": true,
    "scripts": {
        "start": "yarn node ./scripts/next-with-polyfill.cjs dev --webpack",
        "dev": "yarn node ./scripts/next-with-polyfill.cjs dev --webpack",
        "build": "yarn node ./scripts/next-with-polyfill.cjs build --webpack && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
        "serve": "next start",
        "analyze": "yarn node ./scripts/next-with-polyfill.cjs build --webpack",
        "lint": "eslint --fix app components lib layouts scripts"
    },
    "dependencies": {
        "@barba/core": "2.10.3",
        "@emotion/is-prop-valid": "1.4.0",
