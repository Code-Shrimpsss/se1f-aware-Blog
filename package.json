        "gsap": "3.15.0",
        "image-size": "2.0.2",
        "katex": "0.17.0",
        "lucide-react": "1.21.0",
        "next": "16.2.9",
        "next-contentlayer2": "0.5.8",
        "next-intl": "4.13.0",
        "next-themes": "0.4.6",
        "pliny": "0.4.1",
        "postcss": "8.5.15",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "react-use-measure": "2.1.7",
        "reading-time": "1.5.0",
        "rehype-autolink-headings": "7.1.0",
        "rehype-citation": "2.3.2",
        "rehype-katex": "7.0.1",
